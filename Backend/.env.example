# Default local mode is explicit and requires no cloud credentials.
ENVIRONMENT=local
STORAGE_BACKEND=memory
DATA_BACKEND=fixture
AI_BACKEND=fixture
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# For real local cloud access, run gcloud auth application-default login.
# STORAGE_BACKEND=firestore
# DATA_BACKEND=cloud
# AI_BACKEND=gemini
GOOGLE_CLOUD_PROJECT=project-e8b1593d-009a-4822-abf
FIRESTORE_DATABASE=agentic-bi-demo
BIGQUERY_DATASET=agentic_bi_demo
BIGQUERY_LOCATION=asia-southeast1
TEXT_MODEL=gemini-3.8-flash
TEXT_MODEL_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_LOCATION=us-central1
LIVE_MODEL=gemini-live-2.5-flash-native-audio
LIVE_MODEL_LOCATION=us-central1
# Production injects these through Secret Manager. Do not put real secrets here.
GUEST_SIGNING_KEY=
POSTGRES_PASSWORD=
CLOUD_SQL_INSTANCE=project-e8b1593d-009a-4822-abf:asia-southeast1:agentic-bi-demo-pg
POSTGRES_DATABASE=agentic_bi
POSTGRES_USER=bi_reader
# Optional direct local PostgreSQL, instead of Cloud SQL:
# POSTGRES_DSN=postgresql://bi_reader:LOCAL_PASSWORD@localhost:5432/agentic_bi
# Shared public skills library limits (not model-analysis quotas):
SKILL_CATALOG_LIMIT=100
SKILL_GUEST_HOURLY_LIMIT=20
SKILL_WORKSPACE_DAILY_LIMIT=100
